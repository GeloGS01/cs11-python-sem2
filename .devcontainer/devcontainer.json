{
  "name": "CS11 Python (Sem2)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    // Virtual desktop so tkinter windows can be viewed in a browser tab (port 6080)
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "vscode"
    }
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "GUI Desktop (password: vscode)",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "DISPLAY": ":1",
    "TZ": "Asia/Bangkok"
  },
  "postCreateCommand": "pip install --user tzdata",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "files.autoSave": "afterDelay",
        "editor.fontSize": 16,
        "terminal.integrated.fontSize": 15
      }
    }
  }
}
